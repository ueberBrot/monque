{
  "name": "monque",
  "private": true,
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent && effect-tsgo patch --no-typescript --tsrs --oxlint",
    "build": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' build",
    "type-check": "vp run --filter './packages/*' build && effect-tsgo --tsrs-lint vp lint --type-aware --type-check --deny-warnings && vp run --filter @monque/docs type-check",
    "lint:effect": "vp run --filter @monque/core --filter @monque/management lint:effect",
    "lint": "vp run --filter './packages/*' build && effect-tsgo --tsrs-lint vp lint --type-aware --deny-warnings",
    "lint:fast": "vp lint --deny-warnings",
    "lint:fix": "vp run --filter './packages/*' build && effect-tsgo --tsrs-lint vp lint --type-aware --fix",
    "skills": "intent",
    "test": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' test",
    "test:all": "vp test run --project ci && vp run test && vp run @monque/dashboard-dev#test:e2e",
    "verify:consumer": "bun scripts/verification/consumer.mts",
    "test:unit": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' test:unit",
    "test:integration": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' test:integration",
    "check": "vp run type-check && vp fmt --check",
    "clean": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' clean && rimraf node_modules/.vite/task-cache",
    "check:exports": "vp run --filter './packages/*' --filter './apps/*' --filter './examples/*' check:exports",
    "fmt:fix": "vp fmt",
    "fmt:check": "vp fmt --check",
    "benchmark": "bun scripts/benchmarks/run.mts",
    "test:benchmark": "vp test run --config scripts/benchmarks/vite.config.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.69.0",
    "@monque/core": "workspace:*",
    "@monque/management": "workspace:*",
    "@shadcn/lint": "^0.2.5",
    "@tanstack/intent": "0.5.6",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/node": "^22.20.5",
    "effect": "4.1.4",
    "eslint-plugin-sonarjs": "4.2.2",
    "fallow": "3.43.2",
    "knip": "^6.45.1",
    "mongodb": "^7.9.0",
    "publint": "^0.3.25",
    "rimraf": "^6.1.4",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "ultracite": "8.2.1",
    "unplugin-unused": "^0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0",
    "vite-plus": "1.6.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "fallow"
    ]
  }
}
