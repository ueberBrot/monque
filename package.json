{
  "name": "monque",
  "private": true,
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "build": "vp run --filter './packages/*' --filter './apps/*' build",
    "type-check": "vp run --filter './packages/*' --filter './apps/*' type-check && vp lint --type-aware --type-check -A all",
    "test": "vp run --filter './packages/*' --filter './apps/*' test",
    "test:unit": "vp run --filter './packages/*' --filter './apps/*' test:unit",
    "test:integration": "vp run --filter './packages/*' --filter './apps/*' test:integration",
    "check": "vp run type-check && vp check --fix",
    "clean": "vp run --filter './packages/*' --filter './apps/*' clean && rimraf node_modules/.vite/task-cache",
    "check:exports": "vp run --filter './packages/*' --filter './apps/*' check:exports"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^26.6.3",
    "fallow": "3.31.0",
    "knip": "^6.39.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.6.5"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1",
    "vite-plus": "1.0.0"
  }
}
