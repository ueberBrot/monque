# Optional local settings for the dashboard development app.
# Copy to apps/dashboard-dev/.env.local from the repository root.

# mock | db | live
MONQUE_DASHBOARD_DEV_MODE=mock

# Mock mode
MONQUE_DASHBOARD_DEV_SCENARIO=pending-jobs

# Local MongoDB mode (defaults match compose.yml)
MONQUE_DASHBOARD_DEV_MONGO_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONQUE_DASHBOARD_DEV_DATABASE_NAME=monque_dashboard_dev

# Live mode: uncomment and set MODE above to live.
# Use the Management API mount URL, without /api/v1.
# MONQUE_DASHBOARD_DEV_LIVE_API_BASE_URL=http://localhost:3000/ops
