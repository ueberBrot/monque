{
	"name": "@monque/dashboard-dev",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:db": "MONQUE_DASHBOARD_DEV_MODE=db vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "bun run type-check && vitest run --coverage.enabled=false",
		"test:e2e": "bun run --cwd ../.. build --filter=@monque/dashboard-express --filter=@monque/management-express && playwright test"
	},
	"dependencies": {
		"@monque/core": "workspace:*",
		"@monque/dashboard": "workspace:*",
		"@monque/management": "workspace:*",
		"@orpc/openapi": "^1.15.1",
		"@orpc/server": "^1.15.1",
		"mongodb": "^7.6.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "7",
		"@monque/dashboard-express": "workspace:*",
		"@monque/management-express": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.38",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"express": "^5.2.1",
		"jsdom": "^30.1.0",
		"playwright": "^1.63.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
