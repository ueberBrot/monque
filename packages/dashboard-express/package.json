{
  "name": "@monque/dashboard-express",
  "version": "0.3.0",
  "description": "Express adapter for serving the Monque dashboard",
  "keywords": [
    "dashboard",
    "express",
    "jobs",
    "monque",
    "scheduler"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/dashboard-express"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@monque/dashboard": "workspace:^"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "supertest": "^7.3.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
