{
	"name": "@monque/dashboard",
	"version": "0.2.0",
	"description": "Asset-only operator Dashboard for Monque",
	"author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ueberBrot/monque.git",
		"directory": "packages/dashboard"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ueberBrot/monque/issues"
	},
	"homepage": "https://github.com/ueberBrot/monque#readme",
	"sideEffects": [
		"./src/styles.css"
	],
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"monque",
		"dashboard",
		"jobs",
		"scheduler",
		"react",
		"tanstack-router"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"src"
	],
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "tsdown",
		"build:client": "vite build",
		"check:exports": "publint && attw --pack .",
		"clean": "rimraf dist coverage .turbo",
		"preview": "vite preview",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "bun run type-check && vitest run --coverage.enabled=false",
		"lint": "biome check ."
	},
	"dependencies": {
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@babel/core": "7",
		"@base-ui/react": "^1.8.0",
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@monque/management": "^0.5.0",
		"@orpc/client": "^1.15.1",
		"@orpc/contract": "^1.15.1",
		"@orpc/openapi-client": "^1.15.1",
		"@orpc/tanstack-query": "^1.15.1",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.12",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-hotkeys": "^0.10.0",
		"@tanstack/react-query": "^5.103.1",
		"@tanstack/react-query-devtools": "^5.103.1",
		"@tanstack/react-router": "^1.170.38",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-store": "^0.11.1",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-table-devtools": "^9.2.0",
		"@tanstack/router-plugin": "^1.168.40",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^22.20.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@uiw/react-json-view": "^1.12.2",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.3.0",
		"date-fns": "^4.4.0",
		"jsdom": "^30.1.0",
		"lucide-react": "^1.47.0",
		"publint": "^0.3.24",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.3.0",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.23.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
