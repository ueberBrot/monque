{
  "name": "@monque/core",
  "version": "1.18.0",
  "description": "MongoDB-backed job scheduler with atomic locking, exponential backoff, and cron scheduling",
  "keywords": [
    "atomic",
    "background-jobs",
    "cron",
    "distributed",
    "job",
    "mongodb",
    "persistence",
    "queue",
    "scheduler",
    "task-queue",
    "typescript"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "cron-parser": "^5.10.1",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/mongodb": "^12.2.0",
    "@total-typescript/shoehorn": "0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.5",
    "fishery": "^2.4.0",
    "mongodb": "^7.7.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "mongodb": "^7.7.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
