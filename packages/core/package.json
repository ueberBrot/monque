{
  "name": "@monque/core",
  "version": "1.21.0",
  "description": "MongoDB-backed job scheduler with atomic locking, exponential backoff, and cron scheduling",
  "keywords": [
    "atomic",
    "background-jobs",
    "cron",
    "distributed",
    "job",
    "mongodb",
    "persistence",
    "queue",
    "scheduler",
    "task-queue",
    "typescript"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "opentelemetry": [
        "dist/opentelemetry.d.mts"
      ],
      "effect": [
        "dist/effect.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./opentelemetry": {
      "import": {
        "types": "./dist/opentelemetry.d.mts",
        "default": "./dist/opentelemetry.mjs"
      },
      "require": {
        "types": "./dist/opentelemetry.d.cts",
        "default": "./dist/opentelemetry.cjs"
      }
    },
    "./effect": {
      "import": {
        "types": "./dist/effect.d.mts",
        "default": "./dist/effect.mjs"
      },
      "require": {
        "types": "./dist/effect.d.cts",
        "default": "./dist/effect.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "cron-parser": "^5.10.2",
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@faker-js/faker": "^10.6.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@testcontainers/mongodb": "^12.2.1",
    "@total-typescript/shoehorn": "0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.5",
    "fishery": "^2.4.0",
    "mongodb": "^7.9.0",
    "unplugin-unused": "^0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "^4.1.2",
    "@opentelemetry/api": ">=1.9.0 <2",
    "@opentelemetry/resources": ">=2.0.0 <3",
    "@opentelemetry/sdk-metrics": ">=2.0.0 <3",
    "mongodb": "^6.22.0 || ^7.8.0"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/resources": {
      "optional": true
    },
    "@opentelemetry/sdk-metrics": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
