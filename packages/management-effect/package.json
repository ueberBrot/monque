{
  "name": "@monque/management-effect",
  "version": "0.0.0",
  "description": "Portable Effect HTTP routes for the Monque Management Surface",
  "keywords": [
    "effect",
    "jobs",
    "management",
    "monque",
    "openapi",
    "orpc",
    "scheduler"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/management-effect"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orpc/effect": "2.0.0-beta.50",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@monque/core": "workspace:*",
    "@monque/management": "workspace:*",
    "@orpc/client": "2.0.0-beta.50",
    "@orpc/contract": "2.0.0-beta.50",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/node": "^22.20.5",
    "mongodb": "^7.9.0",
    "unplugin-unused": "^0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@monque/core": "^1.15.1",
    "@monque/management": ">=0.12.0 <0.13.0",
    "mongodb": "^6.22.0 || ^7.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
