{
  "name": "@monque/tsed",
  "version": "1.19.0",
  "description": "Ts.ED integration for Monque - A robust, type-safe MongoDB job queue for TypeScript",
  "keywords": [
    "background-jobs",
    "cron",
    "job-queue",
    "mongodb",
    "monque",
    "queue",
    "scheduler",
    "tsed",
    "tsed-module",
    "typescript",
    "worker"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/tsed"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@monque/core": "workspace:*",
    "@testcontainers/mongodb": "^12.2.1",
    "@total-typescript/shoehorn": "0.1.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsed/core": "^8.47.1",
    "@tsed/di": "^8.47.1",
    "@tsed/mongoose": "^8.47.1",
    "@tsed/platform-http": "^8.47.1",
    "@types/node": "^22.20.5",
    "cookie": "^2.0.2",
    "mongodb": "^7.9.0",
    "mongoose": "9.12.2",
    "unplugin-unused": "^0.6.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@monque/core": "^1.21.0",
    "@tsed/core": "^8.41.2",
    "@tsed/di": "^8.41.2",
    "@tsed/mongoose": "^8.41.2",
    "mongodb": "^6.22.0 || ^7.8.0"
  },
  "peerDependenciesMeta": {
    "@tsed/mongoose": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
