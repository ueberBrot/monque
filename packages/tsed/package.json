{
  "name": "@monque/tsed",
  "version": "1.15.0",
  "description": "Ts.ED integration for Monque - A robust, type-safe MongoDB job queue for TypeScript",
  "keywords": [
    "background-jobs",
    "cron",
    "job-queue",
    "mongodb",
    "monque",
    "queue",
    "scheduler",
    "tsed",
    "tsed-module",
    "typescript",
    "worker"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/tsed"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@monque/core": "workspace:*",
    "@testcontainers/mongodb": "^12.2.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsed/core": "^8.40.2",
    "@tsed/di": "^8.40.2",
    "@tsed/mongoose": "^8.40.2",
    "@tsed/platform-http": "^8.40.2",
    "@types/node": "^22.20.4",
    "cookie": "^1.1.1",
    "mongodb": "^7.7.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@monque/core": "^1.15.1",
    "@tsed/core": "^8.40.2",
    "@tsed/di": "^8.40.2",
    "@tsed/mongoose": "^8.40.2",
    "mongodb": "^7.7.0"
  },
  "peerDependenciesMeta": {
    "@tsed/mongoose": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
