{
  "name": "@monque/dashboard-effect",
  "version": "0.0.0",
  "description": "Portable Effect HTTP routes for the Monque Dashboard",
  "keywords": [
    "dashboard",
    "effect",
    "monque"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/dashboard-effect"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@monque/dashboard": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "@monque/core": "workspace:*",
    "@monque/management-express": "workspace:*",
    "@testcontainers/mongodb": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "effect": "4.1.4",
    "express": "^5.3.0",
    "mongodb": "^7.9.0",
    "playwright": "^1.65.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "4.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
