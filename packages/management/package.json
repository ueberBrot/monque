{
	"name": "@monque/management",
	"version": "0.4.1",
	"description": "Framework-neutral management surface for Monque",
	"author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ueberBrot/monque.git",
		"directory": "packages/management"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/ueberBrot/monque/issues"
	},
	"homepage": "https://github.com/ueberBrot/monque#readme",
	"sideEffects": false,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"monque",
		"management",
		"jobs",
		"scheduler",
		"openapi",
		"orpc",
		"zod"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./contract": {
			"import": {
				"types": "./dist/contract.d.mts",
				"default": "./dist/contract.mjs"
			},
			"require": {
				"types": "./dist/contract.d.cts",
				"default": "./dist/contract.cjs"
			}
		}
	},
	"files": [
		"dist",
		"contract",
		"src"
	],
	"scripts": {
		"build": "tsdown",
		"check:exports": "publint && attw --pack .",
		"clean": "rimraf dist coverage .turbo",
		"type-check": "tsc --noEmit",
		"pretest": "bun run type-check",
		"test": "vitest run",
		"test:unit": "bun run type-check && vitest run --config vitest.unit.config.ts --coverage.enabled=false",
		"test:watch": "vitest",
		"test:watch:unit": "vitest --config vitest.unit.config.ts",
		"lint": "biome check ."
	},
	"dependencies": {
		"@orpc/contract": "^1.15.1",
		"@orpc/openapi": "^1.15.1",
		"@orpc/server": "^1.15.1",
		"@orpc/zod": "^1.15.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@monque/core": "^1.12.0",
		"mongodb": "^7.6.0"
	},
	"devDependencies": {
		"@monque/core": "workspace:*",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^22.20.3",
		"@vitest/coverage-v8": "^5.0.1",
		"mongodb": "^7.6.0",
		"tsdown": "^0.23.0",
		"vitest": "^5.0.1"
	}
}
