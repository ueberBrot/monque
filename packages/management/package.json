{
  "name": "@monque/management",
  "version": "0.6.0",
  "description": "Framework-neutral management surface for Monque",
  "keywords": [
    "jobs",
    "management",
    "monque",
    "openapi",
    "orpc",
    "scheduler",
    "zod"
  ],
  "homepage": "https://github.com/ueberBrot/monque#readme",
  "bugs": {
    "url": "https://github.com/ueberBrot/monque/issues"
  },
  "license": "ISC",
  "author": "Maurice de Bruyn <debruyn.maurice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ueberBrot/monque.git",
    "directory": "packages/management"
  },
  "files": [
    "dist",
    "contract",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.mts",
        "default": "./dist/contract.mjs"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@orpc/contract": "^1.15.4",
    "@orpc/openapi": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/zod": "^1.15.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@monque/core": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.20.4",
    "mongodb": "^7.7.0",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@monque/core": "^1.15.0",
    "mongodb": "^7.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
